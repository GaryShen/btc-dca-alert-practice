# 每天檢查（api/check.js）用的環境變數：只填在 Vercel 的 Settings → Environment Variables。
# 這個檔只列名稱和說明，不放值；真正的值不要寫進任何檔案、不要推上 GitHub。

# Supabase 專案網址（btc-dca-alert），例如 https://xxxx.supabase.co
SUPABASE_URL=

# Supabase 的 secret key（後台 Settings → API Keys，sb_secret_ 開頭）。只給排程用，網頁絕對不能放
SUPABASE_SECRET_KEY=

# Telegram bot 的 token（跟 @BotFather 建 bot 時拿到的）
TELEGRAM_BOT_TOKEN=

# 我的 Telegram chat id：通知只傳到這一個
TELEGRAM_CHAT_ID=

# 排程密碼：自己產生一串夠長的亂碼。Vercel 排程會自動帶「Authorization: Bearer 這串」來叫 /api/check
CRON_SECRET=
